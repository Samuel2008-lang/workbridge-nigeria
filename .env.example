# =============================================================================
# WorkBridge — environment template
# Copy to .env and fill values. NEVER commit .env (it is gitignored).
# =============================================================================

# --- Required: new Supabase project (Dashboard → Project Settings → API) ---
SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Vite/client mirrors (same values as above — required for the browser build)
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Required to APPLY schema automatically (pick ONE) ---
# Option A — Database password (Settings → Database → Database password)
SUPABASE_DB_PASSWORD=your-database-password

# Option B — Personal access token (https://supabase.com/dashboard/account/tokens)
# SUPABASE_ACCESS_TOKEN=sbp_...

# Option C — Full Postgres URL (Settings → Database → Connection string → URI)
# DATABASE_URL=postgresql://postgres.your-project-ref:YOUR_PASSWORD@aws-0-....pooler.supabase.com:6543/postgres

# --- Strongly recommended for Edge Functions / wallet deposits (server only) ---
# Settings → API → service_role (secret — never expose to the client / VITE_*)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
VITE_APP_NAME=WorkBridge

# --- Payments (Flutterwave) — optional until you enable wallet top-ups ---
# VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-...
# FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-...   # Edge Function secret only
# FLUTTERWAVE_WEBHOOK_HASH=your-webhook-hash  # Edge Function secret only
